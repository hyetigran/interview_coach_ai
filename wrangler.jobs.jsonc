{
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "interview-coach-local",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "interview-coach-local-media"
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:3000",
    "RECORDING_ALLOWANCE": "3"
  },
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interview-coach-jobs-local",
  "main": "jobs-worker.ts",
  "workflows": [
    {
      "name": "interview-coach-local-preparation",
      "binding": "PROCESSING",
      "class_name": "PreparationWorkflow"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "env": {
    "preview": {
      "name": "interview-coach-jobs-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "interview-coach-preview",
          "migrations_dir": "drizzle",
          "database_id": "59c3b2df-6882-4838-8bf6-73d674a26740"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "interview-coach-preview-media"
        }
      ],
      "vars": {
        "APP_ORIGIN": "https://interview-coach-preview.hyetigran.workers.dev",
        "RECORDING_ALLOWANCE": "3"
      },
      "workflows": [
        {
          "name": "interview-coach-preview-preparation",
          "binding": "PROCESSING",
          "class_name": "PreparationWorkflow"
        }
      ],
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      }
    },
    "production": {
      "name": "interview-coach-jobs-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "interview-coach-production",
          "migrations_dir": "drizzle",
          "database_id": "6b9a1918-cd13-447b-8564-75d2b807bd04"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "interview-coach-production-media"
        }
      ],
      "vars": {
        "APP_ORIGIN": "https://interview-coach.hyetigran.workers.dev",
        "RECORDING_ALLOWANCE": "3"
      },
      "workflows": [
        {
          "name": "interview-coach-production-preparation",
          "binding": "PROCESSING",
          "class_name": "PreparationWorkflow"
        }
      ],
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      }
    }
  }
}
